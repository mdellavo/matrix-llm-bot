# Copy this file to config.toml and fill in your values.

homeserver_url = "https://matrix.org"
username = "my-bot-account"
password = "changeme"

# Room IDs ("!abc123:example.org") or aliases ("#room:example.org") to join and monitor.
rooms = ["#some-room:matrix.org"]

# Optional: device name shown for this login. Defaults to "matrix-llm-bot".
# device_name = "matrix-llm-bot"

# Optional: where the SQLite state/crypto store is persisted. Defaults to "./data/store".
# store_path = "./data/store"

# Optional: directory holding one JSONL log file per room of classified messages.
# Defaults to "./data/messages".
# message_log_dir = "./data/messages"

# Optional: address the status/debugging HTTP server binds to. Defaults to
# loopback-only ("127.0.0.1:8080") since the page and its API expose logged
# message content with no authentication. Only widen this deliberately.
# http_listen_addr = "127.0.0.1:8080"

# Optional: directory of bot commands (one subdirectory per command, each with a
# SKILL.md). Defaults to "./skills". Unlike store_path/message_log_dir, this is
# meant to be committed, not git-ignored.
# skills_dir = "./skills"

# Optional: OMDb API key (https://www.omdbapi.com/apikey.aspx) for the `imdb`
# skill's movie/show lookups. If unset, the `imdb` skill replies with a clear
# "not configured" message instead of attempting a lookup.
# omdb_api_key = "your-key-here"

# Optional: Matrix user IDs whose messages the bot ignores entirely — dropped
# before classification, logging, or any reply, so they never show up in
# message history either. Defaults to empty (ignore nobody).
# ignored_users = ["@spammer:example.org"]

# Optional: where accumulated Claude API token/request usage is persisted as a
# JSON snapshot, so it survives a restart instead of resetting to zero.
# Defaults to "./data/usage.json".
# usage_state_path = "./data/usage.json"

# Optional: how long (in seconds) to pause outgoing Claude API calls after one
# comes back rate-limited (HTTP 429), before trying again. Defaults to 60.
# rate_limit_backoff_secs = 60

# Optional: hard cap on cumulative estimated Claude API cost in USD. Once
# reached, every Claude call site (classifier, chat/greeting replies, skills)
# stops making API calls entirely until the limit is raised or the persisted
# usage state (usage_state_path) is reset. Unset (the default) means no limit.
# cost_limit_usd = 5.00
